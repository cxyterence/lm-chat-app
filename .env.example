# Copy to .env (git-ignored) and fill in. Read by scripts/smoke.sh.
# Quote values that contain spaces.

# Your own server. `scripts/smoke.sh` tests this one.
LLM_BASE_URI=http://192.168.1.5:1234/v1

# Optional. Leave blank if the server needs no key.
LLM_API_KEY=

# Optional. Defaults to the first model the server lists.
LLM_MODEL=

# Optional. One of none, minimal, low, medium, high, xhigh, max, if the model accepts it.
# `swift run chatcli --base <url> --efforts` lists what it accepts. Blank sends no level.
LLM_REASONING_EFFORT=

# OpenAI. `scripts/smoke.sh openai` tests this one.
OPENAI_BASE_URI=https://api.openai.com/v1

# Required. Create one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Required. OpenAI lists non-chat models too, so the first one listed may not chat.
OPENAI_MODEL=gpt-5-mini

# Optional. Same values as LLM_REASONING_EFFORT.
OPENAI_REASONING_EFFORT=
